{
  "name": "@objy/cli",
  "version": "0.1.0",
  "description": "Deploy and manage Objy clusters from one small CLI.",
  "type": "module",
  "bin": {
    "objy": "bin/objy.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "releases",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "check:package": "node scripts/check-package.js",
    "test:smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/objy-org/objy-cli.git"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "ssh2": "^1.17.0"
  }
}
